    "ME": {
      "label": "Montréal-Est",
      "recurring": {
        "garbage": {
          "dayOfWeek": 3,
          "frequency": "weekly",
          "notes": "Black bin Wednesdays. Only bin contents collected — max 50 lbs. Lid closed. Bins at curb no earlier than 12h before pickup."
        },
        "recycling": {
          "dayOfWeek": 4,
          "frequency": "weekly",
          "notes": "Blue bin Thursdays. All containers, packaging, and printed materials accepted (BAC Impact since January 2025). Empty, rinse, flatten cardboard."
        },
        "organics": {
          "dayOfWeek": 3,
          "frequency": "weekly",
          "notes": "Brown bin Wednesdays. Food waste only. No plastic or compostable bags — use paper bags or newspaper."
        },
        "bulky": {
          "dayOfWeek": 3,
          "frequency": "weekly",
          "notes": "Call Services citoyens (514-905-2000) 24h before Wednesday pickup. Construction debris must be corded or containerized — not in black bin. Max 5 m³/week."
        },
        "leaves": {
          "dayOfWeek": 3,
          "frequency": "weekly",
          "notes": "Leaves are accepted with organics collection in the brown bin."
        },
